{
  "name": "velaroute",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Velaroute — the agentic inbound engine: capture, guard, enrich, match, route, book, sync and SLA in one pipeline.",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "build:sqlite": "STORAGE_MODE=sqlite next build",
    "build:browser": "STORAGE_MODE=browser next build",
    "start": "next start -p ${PORT:-3300}",
    "start:local": "bash scripts/start.sh",
    "stop:local": "bash scripts/stop.sh",
    "mcp": "node --import tsx scripts/mcp-stdio.ts",
    "screenshots": "node --import tsx scripts/screenshots.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/openai": "^4.0.108",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.162",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^1.68.0",
    "marked": "^18.1.3",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "openai": "^7.50.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "valyu-js": "^2.11.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
